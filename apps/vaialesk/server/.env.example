PORT=3000
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api-vaialesk
# Opcional: subjects Auth0 exactos de las cuentas administrativas.
ADMIN_AUTH0_SUBS=
# Opcional: ruta persistente para metadatos operativos.
# OPERATIONS_FILE=/ruta/privada/operations.json

# Required for remote operation/sharing; use separate values in staging/production.
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://panel.example.com
# Keep this secret outside the operations file; at least 32 random characters.
AUDIT_SIGNING_KEY=
# Optional notifications: configure FCM v1/APNs in EAS first.
EXPO_ACCESS_TOKEN=
# Optional SOS receiver, HTTPS only; accepts signed JSON + idempotency key.
SOS_WEBHOOK_URL=
SOS_WEBHOOK_SECRET=
# Optional automated encrypted backups (64 hexadecimal characters = 32 bytes).
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
